generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  name        String?
  department  String?
  role        String   @default("user")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  labels      Label[]
  reviews     ReviewItem[]
  verificationCodes EmailVerification[]
  launchProjects LaunchProject[]
  sampleRequests SampleRequest[]
}

// 메일 CTA용 1회용 자동 로그인 토큰 (매직 링크)
model MagicLinkToken {
  id           String    @id @default(uuid())
  token        String    @unique
  email        String
  redirectPath String
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime  @default(now())
}

model EmailVerification {
  id        String   @id @default(uuid())
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
}

model Label {
  id            String   @id @default(uuid())
  productName   String
  productType   String?
  salesChannel  String?
  status        String   @default("draft")
  servingSize   Float?
  servingUnit   String?
  totalContent  Float?
  totalUnit     String?
  shelfLife     String?  // 소비기한(기준 소비기한)
  storageMethod String?  // 보관방법
  crossContaminationAllergens String? // 혼입 가능 알레르기 유발물질
  healthClaims    Json?
  aiNotes         Json?
  labelSnapshot   Json?
  designFileUrl   String?
  designFileName  String?
  designUploadedAt DateTime?
  manufacturingReportUrl   String?  // 품목제조보고서 원본 PDF URL
  manufacturingReportMaskedUrl String?  // 마스킹된 PDF URL (자동 또는 수동)
  manufacturingReportMaskingLocked Boolean @default(false)  // true면 사용자가 영구 마스킹 적용 → 편집 불가
  manufacturingReportName  String?
  manufacturingReportUploadedAt DateTime?
  aiReportExtraction Json?      // 1단계: 품목제조보고서에서 추출한 정보
  aiDesignExtraction Json?      // 2단계: 디자인에서 추출한 정보
  aiDesignReview     Json?      // 3단계: 비교 결과
  aiDesignReviewedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdBy     User     @relation(fields: [createdById], references: [id])
  createdById   String

  nutritionInfo NutritionInfo?
  ingredients   Ingredient[]
  reviewCategories ReviewCategory[]
}

model NutritionInfo {
  id              String @id @default(uuid())
  calories        Float?
  carbohydrates   Float?
  sugars          Float?
  dietaryFiber    Float?
  protein         Float?
  totalFat        Float?
  saturatedFat    Float?
  transFat        Float?
  cholesterol     Float?
  sodium          Float?
  vitaminA        Float?
  vitaminC        Float?
  calcium         Float?
  iron            Float?

  label           Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)
  labelId         String @unique
}

model Ingredient {
  id              String  @id @default(uuid())
  name            String
  ratio           Float
  origin          String?
  allergen        Boolean @default(false)
  allergenInfo    String?
  ingredientType  String  @default("regular") // regular, compound, additive
  subIngredients  Json?   // 복합원재료 구성성분 [{name, ratio?}]
  additivePurpose String? // 식품첨가물 용도 (합성보존료, 합성감미료 등)
  sortOrder       Int     @default(0)

  label           Label   @relation(fields: [labelId], references: [id], onDelete: Cascade)
  labelId         String
}

model ReviewCategory {
  id        String @id @default(uuid())
  name      String
  sortOrder Int    @default(0)

  label     Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)
  labelId   String

  items     ReviewItem[]
}

// ── 신제품 출시 프로세스 관리 ─────────────────────────────
model LaunchProject {
  id               String    @id @default(uuid())
  kind             String    @default("launch") // launch(출시) | discontinuation(단종)
  productName      String
  productType      String?   // 제과, 제빵, 케이크/디저트 등
  description      String?
  targetLaunchDate DateTime? // 출시 예정일(launch) / 단종 목표일(discontinuation)
  status           String    @default("planning") // planning, in_progress, completed, on_hold
  editPasswordHash String?   // 편집 잠금 비밀번호(bcrypt). null이면 잠금 없음
  // 단종 전용
  discontinueReason String?  // 단종 사유 (판매량 저하, 품질 이슈 등)
  // 출시 전략
  brandType        String?   // NB, PNB, PB
  salesChannels    String?   // 영업채널 (쉼표 구분: 자사몰, 쿠팡, ○○마트 PB 등)
  storageCondition String?   // 실온, 냉장, 냉동
  usp              Json?     // USP 배열: 고단백, 저당, 고식이섬유, 개별인정형(식후혈당안정) 등
  targetShelfLife  String?   // 타겟 소비기한 (예: 냉장 30일)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String

  stages         LaunchStage[]
  notifications  LaunchNotificationLog[]
  sampleRequests SampleRequest[]
}

// 영업 선제안용 샘플 요청 — 기획·컨셉 단계 완료 후에만 생성 가능
model SampleRequest {
  id             String   @id @default(uuid())
  recipientName  String?
  recipientEmail String
  dueDate        DateTime // 납기 (언제까지)
  quantity       String?  // 수량
  weightSpec     String?  // 중량/규격
  specDetails    String?  // 스펙 상세
  salesChannel   String?  // 제안 판매채널
  message        String?  // 요청 메시지
  status         String   @default("requested") // requested, in_progress, delivered, canceled
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  requestedBy   User   @relation(fields: [requestedById], references: [id])
  requestedById String

  project   LaunchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
}

model LaunchStage {
  id          String    @id @default(uuid())
  name        String
  department  String
  ownerName   String?
  ownerEmail  String?
  status      String    @default("pending") // pending, in_progress, completed
  dueDate     DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  sortOrder   Int       @default(0)

  project   LaunchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  tasks LaunchTask[]
}

model LaunchTask {
  id          String    @id @default(uuid())
  name        String
  checkPoint  String?   // 체크해야 하는 사항(검수 포인트)
  isCompleted Boolean   @default(false)
  completedBy String?
  completedAt DateTime?
  note        String?
  sortOrder   Int       @default(0)

  stage   LaunchStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  stageId String
}

model LaunchNotificationLog {
  id      String   @id @default(uuid())
  type    String   // stage_start, manual, schedule_d30, schedule_d14, schedule_d7, schedule_d3, schedule_d1, schedule_d0
  stageId String?
  sentTo  String
  sentAt  DateTime @default(now())

  project   LaunchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
}

model ReviewItem {
  id            String   @id @default(uuid())
  taskName      String
  department    String
  isCompleted   Boolean  @default(false)
  reviewerName  String?
  reviewerNote  String?
  completedAt   DateTime?
  sortOrder     Int      @default(0)

  category    ReviewCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId  String

  reviewer    User?    @relation(fields: [reviewerId], references: [id])
  reviewerId  String?
}
