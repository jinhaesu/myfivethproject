generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  name        String?
  department  String?
  role        String   @default("user")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  labels      Label[]
  reviews     ReviewItem[]
  verificationCodes EmailVerification[]
}

model EmailVerification {
  id        String   @id @default(uuid())
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
}

model Label {
  id            String   @id @default(uuid())
  productName   String
  productType   String?
  salesChannel  String?
  status        String   @default("draft")
  servingSize   Float?
  servingUnit   String?
  totalContent  Float?
  totalUnit     String?
  shelfLife     String?  // 소비기한(기준 소비기한)
  storageMethod String?  // 보관방법
  crossContaminationAllergens String? // 혼입 가능 알레르기 유발물질
  healthClaims    Json?
  aiNotes         Json?
  labelSnapshot   Json?
  designFileUrl   String?
  designFileName  String?
  designUploadedAt DateTime?
  manufacturingReportUrl   String?  // 품목제조보고서 원본 PDF URL
  manufacturingReportMaskedUrl String?  // 배합비율 마스킹된 PDF URL (없으면 마스킹 실패)
  manufacturingReportName  String?
  manufacturingReportUploadedAt DateTime?
  aiReportExtraction Json?      // 1단계: 품목제조보고서에서 추출한 정보
  aiDesignExtraction Json?      // 2단계: 디자인에서 추출한 정보
  aiDesignReview     Json?      // 3단계: 비교 결과
  aiDesignReviewedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdBy     User     @relation(fields: [createdById], references: [id])
  createdById   String

  nutritionInfo NutritionInfo?
  ingredients   Ingredient[]
  reviewCategories ReviewCategory[]
}

model NutritionInfo {
  id              String @id @default(uuid())
  calories        Float?
  carbohydrates   Float?
  sugars          Float?
  dietaryFiber    Float?
  protein         Float?
  totalFat        Float?
  saturatedFat    Float?
  transFat        Float?
  cholesterol     Float?
  sodium          Float?
  vitaminA        Float?
  vitaminC        Float?
  calcium         Float?
  iron            Float?

  label           Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)
  labelId         String @unique
}

model Ingredient {
  id              String  @id @default(uuid())
  name            String
  ratio           Float
  origin          String?
  allergen        Boolean @default(false)
  allergenInfo    String?
  ingredientType  String  @default("regular") // regular, compound, additive
  subIngredients  Json?   // 복합원재료 구성성분 [{name, ratio?}]
  additivePurpose String? // 식품첨가물 용도 (합성보존료, 합성감미료 등)
  sortOrder       Int     @default(0)

  label           Label   @relation(fields: [labelId], references: [id], onDelete: Cascade)
  labelId         String
}

model ReviewCategory {
  id        String @id @default(uuid())
  name      String
  sortOrder Int    @default(0)

  label     Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)
  labelId   String

  items     ReviewItem[]
}

model ReviewItem {
  id            String   @id @default(uuid())
  taskName      String
  department    String
  isCompleted   Boolean  @default(false)
  reviewerName  String?
  reviewerNote  String?
  completedAt   DateTime?
  sortOrder     Int      @default(0)

  category    ReviewCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId  String

  reviewer    User?    @relation(fields: [reviewerId], references: [id])
  reviewerId  String?
}
